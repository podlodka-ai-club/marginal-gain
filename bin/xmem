#!/usr/bin/env bash
# Рубильники памяти одной командой. Реестр и вся работа — в pipeline/switch.py,
# здесь только корень в путь поиска: команду зовут из любого каталога, и
# полагаться на то, что она запущена из репозитория, нельзя.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m pipeline.switch "$@"
