# Хранилище xmemory, в которое пишет модуль.
# Идентификатор смотреть в: xmemcli org list instances
XMEM_INSTANCE_ID=

# Путь наружу: cli (консоль, только текст), api (HTTP), sdk (клиент для Python).
# Структурная запись есть только у api и sdk.
XMEM_BACKEND=cli

# Ключ доступа. Нужен только для api и sdk, консоль обходится без него.
XMEM_API_KEY=

# Адрес сервиса. Пусто значит по умолчанию, https://api.xmemory.ai
XMEM_API_URL=

# Потолок ожидания ответа, секунды. Пусто значит по умолчанию, 180.
XMEM_TIMEOUT=
