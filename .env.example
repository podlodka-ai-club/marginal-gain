# Хранилище xmemory, в которое пишет модуль.
# Идентификатор смотреть в: xmemcli org list instances
XMEM_INSTANCE_ID=

# Путь наружу: cli (консоль, только текст), api (HTTP), sdk (клиент для Python),
# local (SQLite рядом с проектом). Структурная запись есть у api, sdk и local.
# У local нет ни ключа, ни сети, ни квоты — но нет и читателя: на запрос
# приходят найденные записи, а не пересказ.
XMEM_BACKEND=cli

# Ключ доступа. Нужен только для api и sdk, консоль обходится без него.
XMEM_API_KEY=

# Адрес сервиса. Пусто значит по умолчанию, https://api.xmemory.ai
XMEM_API_URL=

# Потолок ожидания ответа, секунды. Пусто значит по умолчанию, 180.
XMEM_TIMEOUT=

# Файл локальной базы. Нужен только для local.
# Пусто значит по умолчанию, ~/.local/state/memory-encoder/memory.db
XMEM_LOCAL_PATH=
