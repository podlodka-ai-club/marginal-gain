# Собранное на прогоне, а не написанное руками. В репозитории ему делать
# нечего: байт-код меняется на каждом запуске, и `git pull --rebase` у всех
# упирается в «cannot pull with rebase: you have unstaged changes».
__pycache__/
*.pyc

# То же самое, только от pytest и hypothesis: кэш сборки и база примеров.
.pytest_cache/
.hypothesis/

# База аудита прогонов замера (`eval.live`, `storage.audit`). Растёт с каждым
# прогоном и не сводится в компактную историю, как `eval-runs.jsonl` — в
# отличие от него в git не идёт, коммит раздул бы репозиторий бинарником.
eval-audit.db
eval-audit.db-wal
eval-audit.db-shm
eval-audit.db-journal
